{
  "name": "note-to-json",
  "version": "0.0.1",
  "description": "Obsidian 插件：Markdown 排版格式化与简化，以及 JSON 格式化与压缩。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.json && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "markdown",
    "formatter",
    "json"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  }
}
